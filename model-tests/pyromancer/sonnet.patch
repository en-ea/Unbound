diff --git a/game/scripts/player/phoenix.gd b/game/scripts/player/phoenix.gd
new file mode 100644
index 0000000..c1cefb2
--- /dev/null
+++ b/game/scripts/player/phoenix.gd
@@ -0,0 +1,150 @@
+class_name Phoenix
+extends Node
+## Pyromancer's Phoenix Wings: huge fiery wings burst from your back, you leap high, then slam down in a
+## firestorm that hurts and burns everyone near. The leap is a visual lift (the body stays on the ground).
+
+const RADIUS := 7.0
+const POWER := 4.0
+const HEIGHT := 2.6
+
+var player: CharacterBody3D
+var _busy := false
+
+
+func _init(p: CharacterBody3D = null) -> void:
+	player = p
+
+
+## One wing: fanned feathers (fire-gradient kites) from the shoulder. side = +1 / -1.
+static func _wing(side: float) -> Node3D:
+	var root := Node3D.new()
+	var mat := StandardMaterial3D.new()
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	mat.blend_mode = BaseMaterial3D.BLEND_MODE_MIX
+	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
+	mat.vertex_color_use_as_albedo = true
+	mat.disable_receive_shadows = true
+	for layer in 3:
+		var st := SurfaceTool.new()
+		st.begin(Mesh.PRIMITIVE_TRIANGLES)
+		var n := 11
+		for i in n:
+			var k := float(i) / (n - 1)
+			var ang := deg_to_rad(lerpf(70.0, -62.0, k)) # from raised up-and-out to swept low
+			var len := lerpf(3.4, 2.0, abs(k - 0.25) * 1.2) * (1.0 - layer * 0.18) + (0.5 if i % 2 == 0 else 0.0)
+			var w := 0.3 * (1.0 - layer * 0.15)
+			var d := Vector3(cos(ang) * side, sin(ang), -0.35 * k).normalized()  # outwards (x), up (y)
+			var nrm := d.cross(Vector3(0, 0, 1)).normalized() * w
+			var root_p := Vector3(0.12 * side, 0.0, 0.0)
+			var mid := root_p + d * len * 0.45
+			var tip := root_p + d * len + Vector3(0, 0, -0.1 * k)
+			var c_root := Color(1.0, 0.8, 0.25, 1.0)
+			var c_mid := Color(0.9, 0.15, 0.03, 0.95).lerp(Color(1.0, 0.72, 0.12, 0.95), (1.0 if i % 2 == 0 else 0.0) * (1.0 - layer * 0.35) + layer * 0.15)
+			var c_tip := Color(1.0, 0.85, 0.3, 0.0) if i % 2 == 0 else Color(0.6, 0.05, 0.0, 0.0)
+			var cm := c_mid
+			cm.a *= 0.9
+			for tri in [[root_p, c_root, mid + nrm, cm, mid - nrm, cm], [mid + nrm, cm, tip, c_tip, mid - nrm, cm]]:
+				for j in 3:
+					st.set_color(tri[j * 2 + 1])
+					st.add_vertex(tri[j * 2])
+		var mi := MeshInstance3D.new()
+		mi.mesh = st.commit()
+		mi.material_override = mat
+		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		mi.position.z = -0.02 * layer
+		mi.rotation.y = side * deg_to_rad(layer * 5.0)
+		root.add_child(mi)
+	return root
+
+
+func cast() -> void:
+	if _busy:
+		return
+	_busy = true
+	var vis: Node3D = player.visual
+	var tree := get_tree()
+	var root := player.get_parent()
+	var abil: Abilities = player.abilities
+	abil._play("cast", 0.7, 0.0)
+	vis.play_action("Jump_Start", 1.3)
+	# wings
+	var rig := Node3D.new()
+	rig.position = Vector3(0, 1.35, -0.28)
+	rig.scale = Vector3.ONE * 0.05
+	vis.add_child(rig)
+	var wl := _wing(-1.0)
+	var wr := _wing(1.0)
+	rig.add_child(wl)
+	rig.add_child(wr)
+	var glow := OmniLight3D.new()
+	glow.light_color = Color(1.0, 0.55, 0.2)
+	glow.light_energy = 2.0
+	glow.omni_range = 11.0
+	glow.position = Vector3(0, 0.3, -0.8)
+	rig.add_child(glow)
+	var embers := FireFX.flames(rig, Vector3.ZERO, 0.9, 60, 0.9, false, 0.3)
+	embers.local_coords = false
+	embers.position = Vector3(0, 0.6, -0.6)
+	embers.gravity = Vector3(0, 3.0, 0)
+	embers.spread = 60.0
+	embers.initial_velocity_max = 3.5
+	FireFX.blast(root, player.global_position, 1.8)
+	FireFX.flames(root, player.global_position + Vector3(0, 0.5, 0), 1.2, 50, 0.8, true, 0.8)
+	tree.call_group("camera_rig", "shake", 0.25)
+	# burst open with an overshoot
+	var t := rig.create_tween().set_parallel(true)
+	t.tween_property(rig, "scale", Vector3.ONE * 1.05, 0.28).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
+	t.tween_property(wl, "rotation:z", 0.0, 0.0)
+	# the leap (visual lift) with wing beats
+	var rise := vis.create_tween()
+	rise.tween_property(vis, "position:y", HEIGHT, 0.55).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT).set_delay(0.18)
+	var beat := rig.create_tween().set_loops(3)
+	beat.tween_method(func(k: float) -> void:
+		wl.rotation.y = -k * 0.45
+		wr.rotation.y = k * 0.45, 0.0, 1.0, 0.18).set_delay(0.2)
+	beat.tween_method(func(k: float) -> void:
+		wl.rotation.y = -k * 0.45
+		wr.rotation.y = k * 0.45, 1.0, -0.3, 0.18)
+	# slam
+	tree.create_timer(1.15).timeout.connect(func() -> void:
+		var fall := vis.create_tween()
+		fall.tween_property(vis, "position:y", 0.0, 0.16).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
+		fall.tween_callback(func() -> void: _slam(rig)))
+
+
+func _slam(rig: Node3D) -> void:
+	var root := player.get_parent()
+	var abil: Abilities = player.abilities
+	var at := player.global_position
+	FireFX.blast(root, at, RADIUS)
+	FireFX.blast(root, at, RADIUS * 0.6)
+	FireFX.flames(root, at + Vector3(0, 0.3, 0), RADIUS * 0.9, 160, 1.1, true, 1.1)
+	for k in 12: # a ring of fire pillars
+		var a := TAU * k / 12.0
+		var p := at + Vector3(cos(a), 0, sin(a)) * RADIUS * 0.65
+		var f := FireFX.flames(root, p, 0.5, 40, 1.0, true, 0.8)
+		f.initial_velocity_min = 4.0
+		f.initial_velocity_max = 10.0
+		f.spread = 12.0
+		f.direction = Vector3.UP
+	abil._play("burst", 0.6, 3.0)
+	abil._play("thud", 0.45, 2.0)
+	get_tree().call_group("camera_rig", "shake", 0.6)
+	for e in get_tree().get_nodes_in_group("enemy"):
+		if e.get_meta("crowd_ignore", false) or not e.is_alive():
+			continue
+		var d: float = (e as Node3D).global_position.distance_to(at)
+		if d > RADIUS:
+			continue
+		var dmg := maxi(1, roundi(Gear.hit_damage(POWER)[0] * lerpf(1.0, 0.55, d / RADIUS)))
+		e.take_hit(at, dmg, 3.0)
+		FloatText.spawn(get_tree(), (e as Node3D).global_position + Vector3(0, 1.6, 0), str(dmg) + "!", Color(1.0, 0.55, 0.2), true)
+		FireFX.ignite(e, 5.0)
+	FireFX.burning_ground(root, at, RADIUS * 0.7, 5.0, 1)
+	var out := rig.create_tween()
+	out.tween_interval(0.35)
+	out.tween_property(rig, "scale", Vector3.ONE * 0.05, 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
+	out.tween_callback(func() -> void:
+		rig.queue_free()
+		_busy = false)
