+def robe_at(a, z, out=0.03):
+    """A point on the robe's surface at angle `a` (0 = +X, -90 = the front) and height z."""
+    rs = ROBE_RINGS
+    for (z0, rx0, ry0), (z1, rx1, ry1) in zip(rs, rs[1:]):
+        if z0 <= z <= z1:
+            k = (z - z0) / (z1 - z0)
+            rx, ry = rx0 + (rx1 - rx0) * k, ry0 + (ry1 - ry0) * k
+            break
+    else:
