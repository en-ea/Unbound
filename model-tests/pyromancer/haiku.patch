diff --git a/game/scripts/player/phoenix_wings.gd b/game/scripts/player/phoenix_wings.gd
new file mode 100644
index 0000000..893c055
--- /dev/null
+++ b/game/scripts/player/phoenix_wings.gd
@@ -0,0 +1,233 @@
+class_name PhoenixWings
+extends Node
+## Phoenix Wings (Pyromancer): fiery wings burst out of your back, you leap high, hang for a moment with
+## the wings spread wide, then slam down in a firestorm that burns and throws back everyone near the landing.
+## While the leap runs, player.gd takes its height from vertical() (see player.gd _vertical()).
+
+enum Phase { IDLE, RISE, HANG, SLAM }
+
+const LAUNCH := 15.0          # up speed (m/s): about 5 m high
+const GRAVITY := 22.0         # the player's own
+const HANG_TIME := 0.4        # seconds at the top, wings wide
+const SLAM_SPEED := 46.0
+const RADIUS := 4.8
+const POWER := 3.0            # times a normal sword hit
+
+var phase := Phase.IDLE
+var t := 0.0                  # seconds into the current phase
+var player: CharacterBody3D
+var _root: Node3D             # the wings, on the player's visual so they turn with facing
+var _pivots: Array[Node3D] = []
+var _fires: Array[CPUParticles3D] = []
+var _light: OmniLight3D
+var _spread := 0.0
+var _fold := 0.0
+var _flare := 0.0
+var _clock := 0.0
+
+
+func _ready() -> void:
+	player = get_parent().get_parent()
+	set_process(false)
+
+
+## Starts the leap (Abilities.use() calls this).
+func cast() -> void:
+	if phase != Phase.IDLE:
+		return
+	if _root == null:
+		_build()
+	phase = Phase.RISE
+	t = 0.0
+	_flare = 0.0
+	player.phoenix_leap = self
+	player.velocity.y = LAUNCH
+	_root.visible = true
+	for f in _fires:
+		f.emitting = true
+	set_process(true)
+	FireFX.flames(player.get_parent(), player.global_position + Vector3(0, 0.2, 0), 0.7, 40, 0.6, true, 0.6)
+	(get_parent() as Abilities)._play("burst", 1.3, -2.0)
+	get_tree().call_group("camera_rig", "shake", 0.12)
+
+
+## Player.gd asks every physics frame for the height speed while the leap runs.
+func vertical(delta: float, vy: float) -> float:
+	t += delta
+	match phase:
+		Phase.RISE:
+			vy -= GRAVITY * delta
+			if vy <= 0.0:
+				phase = Phase.HANG
+				t = 0.0
+				return 0.0
+			return vy
+		Phase.HANG:
+			if t >= HANG_TIME:
+				phase = Phase.SLAM
+				t = 0.0
+				(get_parent() as Abilities)._play("cast", 0.6, 2.0)
+				return -SLAM_SPEED
+			return 0.0
+		Phase.SLAM:
+			if (t > 0.12 and player.is_on_floor()) or t > 4.0:
+				_impact(player.global_position)
+				return 0.0
+			return -SLAM_SPEED
+	return 0.0
+
+
+## The landing: a blast of fire, burning ground, and everyone close is hit and set alight.
+func _impact(at: Vector3) -> void:
+	phase = Phase.IDLE
+	player.phoenix_leap = null
+	_flare = 0.35
+	var root := player.get_parent()
+	FireFX.blast(root, at, RADIUS)
+	FireFX.flames(root, at + Vector3(0, 0.2, 0), RADIUS * 0.8, 90, 0.8, true, 0.7)
+	FireFX.burning_ground(root, at, 3.0, 4.0, 1)
+	(get_parent() as Abilities)._play("burst", 0.7, 4.0)
+	get_tree().call_group("camera_rig", "shake", 0.35)
+	for e in get_tree().get_nodes_in_group("enemy"):
+		if e.get_meta("crowd_ignore", false) or not e.is_alive():
+			continue
+		var n := e as Node3D
+		if n.global_position.distance_to(at) > RADIUS:
+			continue
+		var dmg: int = Gear.hit_damage(POWER)[0]
+		e.take_hit(at, dmg, 2.5)
+		FireFX.ignite(e, 4.0)
+		FloatText.spawn(get_tree(), n.global_position + Vector3(0, 1.6, 0), str(dmg), Color(1.0, 0.6, 0.25))
+
+
+func _process(delta: float) -> void:
+	_clock += delta
+	var spread_goal := 0.0
+	var fold_goal := 0.0
+	var flap := 0.0
+	match phase:
+		Phase.RISE:
+			spread_goal = 1.0
+			flap = sin(_clock * 12.0) * 0.4
+		Phase.HANG:
+			spread_goal = 1.15
+			flap = sin(_clock * 3.0) * 0.08
+		Phase.SLAM:
+			spread_goal = 0.3
+			fold_goal = 1.0
+	if phase == Phase.IDLE and _flare > 0.0:
+		_flare -= delta
+		spread_goal = 1.35
+	var k := clampf(delta * 9.0, 0.0, 1.0)
+	_spread = lerpf(_spread, spread_goal, k)
+	_fold = lerpf(_fold, fold_goal, k)
+	for i in _pivots.size():
+		var side := 1.0 if i == 0 else -1.0
+		_pivots[i].rotation.z = side * (lerpf(-0.1, 0.45, _spread) + flap)
+		_pivots[i].rotation.x = lerpf(-0.35, -1.2, _fold)
+	_light.light_energy = (2.5 + sin(_clock * 23.0) * 0.6 + randf() * 0.4) * clampf(_spread, 0.0, 1.0) if phase != Phase.IDLE or _flare > 0.0 else lerpf(_light.light_energy, 0.0, k)
+	if phase == Phase.IDLE and _flare <= 0.0 and _spread < 0.03:
+		_root.visible = false
+		for f in _fires:
+			f.emitting = false
+		set_process(false)
+
+
+const FEATHERS := 7
+
+## The leading edge of one wing: from the shoulder (0,0) out and up to the wing tip. s runs 0 to 1.
+static func _edge(s: float) -> Vector2:
+	return Vector2(2.4 * s, 0.9 * s + 1.2 * s * s)
+
+
+## Feather i sits on the edge (further out for the higher ones) and points out and back from it.
+static func _feather(i: int) -> Dictionary:
+	var u := float(i) / float(FEATHERS - 1)
+	var s := 0.3 + 0.7 * u
+	var a := lerpf(-0.45, 0.7, u)                  # the top feathers point up and out, the low ones out and back
+	var L := 0.8 + 1.1 * sin(PI * 0.5 * s)
+	return {"base": _edge(s), "dir": Vector2(cos(a), sin(a)), "len": L, "u": u}
+
+
+## The wings: a membrane of flame between the shoulders and the edge, feathers of fire along the edge, and fire at a few tips.
+func _build() -> void:
+	_root = Node3D.new()
+	_root.name = "PhoenixWings"
+	_root.position = Vector3(0, 1.3, -0.2)
+	player.visual.add_child(_root)
+	_root.visible = false
+	var mat := StandardMaterial3D.new()
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.vertex_color_use_as_albedo = true
+	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	mat.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
+	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
+	for side: float in [1.0, -1.0]:
+		var pivot := Node3D.new()
+		pivot.position = Vector3(side * 0.12, 0, 0)
+		_root.add_child(pivot)
+		_pivots.append(pivot)
+		var mi := MeshInstance3D.new()
+		mi.mesh = _wing_mesh(side, mat)
+		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		pivot.add_child(mi)
+		for i in [4, 5, 6]:                          # the tips of the three longest feathers breathe fire
+			var f := _feather(i)
+			var at: Vector2 = f["base"] + (f["dir"] as Vector2) * f["len"]
+			var tip := Node3D.new()
+			tip.position = Vector3(side * at.x, at.y, -0.4 * float(f["u"]))
+			pivot.add_child(tip)
+			var fire := FireFX.flames(tip, tip.global_position, 0.25, 26, 0.45, false, 0.55)
+			fire.local_coords = true
+			fire.position = Vector3.ZERO
+			fire.emitting = false
+			_fires.append(fire)
+	_light = OmniLight3D.new()
+	_light.light_color = Color(1.0, 0.5, 0.2)
+	_light.light_energy = 0.0
+	_light.omni_range = 9.0
+	_light.position = Vector3(0, 0.4, 0.3)
+	_root.add_child(_light)
+
+
+## One wing (x mirrored for the left). Membrane: fans from the shoulder to each stretch of the edge, fading
+## out towards the outside. Feathers: a bright root, orange middle, red transparent tip, two layers.
+func _wing_mesh(side: float, mat: Material) -> ArrayMesh:
+	var st := SurfaceTool.new()
+	st.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var membrane_col := Color(1.0, 0.4, 0.08, 0.85)
+	var membrane_out := Color(1.0, 0.25, 0.05, 0.0)
+	var steps := 12
+	for k in steps:
+		var s0 := float(k) / steps
+		var s1 := float(k + 1) / steps
+		var p0 := _edge(s0)
+		var p1 := _edge(s1)
+		_tri(st, side, Vector2.ZERO, p0, p1, Color(1.0, 0.6, 0.25, 0.8), membrane_col, membrane_col, Vector3(0, 0, 0.0))
+		_tri(st, side, p0, p1, p1 + Vector2(0.25, -0.1) * s1, membrane_col, membrane_col, membrane_out, Vector3.ZERO)
+	for layer in 2:
+		for i in FEATHERS:
+			var f := _feather(i)
+			var base: Vector2 = f["base"]
+			var dir: Vector2 = f["dir"]
+			var L: float = f["len"] * (1.0 if layer == 0 else 1.2)
+			var perp := Vector2(-dir.y, dir.x) * (0.17 if layer == 0 else 0.26)
+			var tip := base + dir * L
+			var mid := base + dir * L * 0.55 + perp * 0.6
+			var root_col := Color(1.0, 0.85, 0.4, 1.0) if layer == 0 else Color(1.0, 0.45, 0.12, 0.6)
+			var mid_col := Color(1.0, 0.5, 0.12, 0.9) if layer == 0 else Color(1.0, 0.3, 0.06, 0.4)
+			var tip_col := Color(0.9, 0.2, 0.04, 0.0)
+			var z := -0.4 * float(f["u"])
+			_tri(st, side, base + perp, base - perp, tip, root_col, root_col, tip_col, Vector3(0, 0, z))
+			_tri(st, side, base + perp, mid, tip, root_col, mid_col, tip_col, Vector3(0, 0, z))
+			_tri(st, side, base - perp, mid, tip, root_col, mid_col, tip_col, Vector3(0, 0, z))
+	st.set_material(mat)
+	return st.commit()
+
+
+## One triangle of the wing; `z` offsets the whole triangle (the wing curls back a little).
+func _tri(st: SurfaceTool, side: float, a: Vector2, b: Vector2, c: Vector2, ca: Color, cb: Color, cc: Color, z: Vector3) -> void:
+	for pair in [[a, ca], [b, cb], [c, cc]]:
+		var v: Vector2 = pair[0]
+		st.set_color(pair[1])
+		st.add_vertex(Vector3(side * v.x, v.y, 0.0) + z)
